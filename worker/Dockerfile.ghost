FROM python:3.11-slim-bookworm

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    libgl1 libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

COPY worker/requirements-ghost.txt /app/worker/
RUN pip install --no-cache-dir -r /app/worker/requirements-ghost.txt

COPY worker /app/worker

ENV PYTHONPATH=/app
ENV GHOST_SERVER_PORT=8090

EXPOSE 8090
CMD ["python", "-m", "worker.ghost_server"]
