# Auth provider: demo (default) | supabase (future)
VITE_AUTH_PROVIDER=demo

# Storage provider: local (default) | supabase (future)
# VITE_STORAGE_PROVIDER=local

# Supabase — uncomment when wiring cloud auth + storage
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_ANON_KEY=your-anon-key
