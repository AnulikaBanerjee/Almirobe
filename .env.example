# Auth provider: demo (default) | supabase (future)
VITE_AUTH_PROVIDER=demo

# Storage provider: local (default) | supabase (future)
# VITE_STORAGE_PROVIDER=local

# Image storage: auto (default) | local-disk | indexeddb | supabase
# auto = Supabase when URL+key set, else local disk in dev, IndexedDB in production build
VITE_IMAGE_PROVIDER=auto

# Supabase — set these to use Supabase Storage for photos
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_ANON_KEY=your-anon-key
