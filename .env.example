# Auth: demo (local, default) | api (Java backend)
VITE_AUTH_PROVIDER=demo

# Java API (when VITE_AUTH_PROVIDER=api)
VITE_API_BASE_URL=http://localhost:8080
# Must match the OAuth client in Google Cloud Console (Web client).
# Authorized JavaScript origins: http://localhost:5173
VITE_GOOGLE_CLIENT_ID=

# After changing openapi/openapi.yaml, regenerate TS types:
# npm run generate:api-types

# Backend — required for Google sign-in when VITE_AUTH_PROVIDER=api
# (Same client ID as VITE_GOOGLE_CLIENT_ID; ./scripts/dev.sh can copy it automatically.)
JWT_SECRET=dev-secret-change-me-at-least-32-characters-long
GOOGLE_CLIENT_ID=
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_DB=almirobe
# POSTGRES_USER=almirobe
# POSTGRES_PASSWORD=almirobe
# REDIS_HOST=localhost
# S3_ENDPOINT=http://localhost:9000
# S3_ACCESS_KEY=almirobe
# S3_SECRET_KEY=almirobe-secret
# S3_BUCKET=almirobe

# Image storage: auto (default) | local-disk | indexeddb | supabase
VITE_IMAGE_PROVIDER=auto

# Supabase — set these to use Supabase Storage for photos
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_ANON_KEY=your-anon-key
